{
 "issue": 2493,
 "accessed": "2026-10-20",
 "purpose": "Establish which assembly the synthetic EUR fixture pair's coordinates and calls belong to, and record each row's GRCh37 position and strand from two agreeing routes.",
 "claims": [
  {
   "id": "C1",
   "kind": "reference-assembly fact",
   "claim": "The template's coordinates are the PCA bundle's GRCh38 AIM positions: 5,000/5,000 rows equal aim_positions_grch38; 4,795/4,795 rsIDs with one primary Ensembl GRCh38 mapping sit at it (190 have no GRCh38 record under that ID); 100/100 dbSNP sample rows sit at GRCh38, 3 of them where both builds coincide. Every call draws on the AIM's GRCh38 allele pair (5,000/5,000), so the calls are on the GRCh38 strand.",
   "result": "holds"
  },
  {
   "id": "C2",
   "kind": "coordinate correspondence",
   "claim": "For 4,979 rows the rsID's GRCh37 placement (Ensembl GRCh37 Variation for 4,974; dbSNP GRCh37 for 5) equals the Ensembl assembly-map projection of the row's GRCh38 coordinate.",
   "result": "4,979 agree"
  },
  {
   "id": "C3",
   "kind": "coordinate correspondence (projection + assembly sequence)",
   "claim": "The 15 vendor i probes take the assembly-map projection, and the GRCh37 flank at it matches the GRCh38 flank exactly (0 mismatches one way, >=30 the other); 13 of 15 also land on a GRCh37 VEP bundle variant whose alleles include the AIM's.",
   "result": "15 placed; flank 15/15; allele control 13/15"
  },
  {
   "id": "C4",
   "kind": "coordinate correspondence (identity + assembly sequence)",
   "claim": "Six rsIDs in regions restructured between builds take the rsID's Ensembl GRCh37 placement, which dbSNP's matches and whose GRCh37 flank matches the GRCh38 flank exactly; the projection has no single base (4) or lands on another copy (2).",
   "result": "6 placed; flank 6/6"
  },
  {
   "id": "C5",
   "kind": "control",
   "claim": "Ensembl GRCh37 Variation (release 116) equals the v4.0.0 VEP bundle (Ensembl 112) for all 4,980 rsIDs both carry; dbSNP GRCh37 equals Ensembl GRCh37 for the 100-rsID sample.",
   "result": "holds"
  },
  {
   "id": "C6",
   "kind": "strand orientation",
   "claim": "Six loci are reversed between builds (rs28493303, rs11901495, rs28689766, rs11638659, rs75536403, rs199898426); the other 4,994 keep their orientation. 4,972 rows are decided by identity (Ensembl per-build allele strings) and projection strand together; the 27 decided by one of those agree with the flank comparison; rs2270662 is decided by the flank alone. For all 28 flank-checked rows the GRCh37 centre base belongs to the oriented AIM pair.",
   "result": "6 reversed, calls complemented"
  }
 ],
