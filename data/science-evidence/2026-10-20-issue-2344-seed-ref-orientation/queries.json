{
  "issue": 2344,
  "accessed": "2026-10-20",
  "purpose": "Pin the REF of every GRCh37 coordinate seed row the panel-rsID oracle covers, and check that the oracle's reference allele (the first element of its Ensembl GRCh37 allele_string) is the assembly base.",
  "claims": [
    {
      "id": "C1",
      "claim": "For each of the 38 single-base rsIDs carried by vep_seed.csv, clinvar_seed.csv and gnomad_seed.csv and covered by the GRCh37 coordinate oracle, the GRCh37 assembly base at the oracle position is the first allele of the oracle's Ensembl GRCh37 allele_string (or, for the four non-panel rsIDs, the pinned base).",
      "kind": "definitional / reference-assembly fact",
      "result": "holds for all 38"
    },
    {
      "id": "C2",
      "claim": "Every such seed row declares that assembly base as REF, except rs6025 (seeds C>T at 1:169519049, assembly base T).",
      "kind": "reference-assembly fact",
      "result": "37 of 38 agree; rs6025 is reversed in all three seeds (filed as #2541)"
    }
  ],
  "sources": [
    {
      "name": "Ensembl GRCh37 REST, GET sequence/region/human/{chrom}:{pos}..{pos}:1",
      "url_pattern": "https://grch37.rest.ensembl.org/sequence/region/human/{chrom}:{pos}..{pos}:1?content-type=application/json",
      "license": "Ensembl terms of use: https://www.ensembl.org/info/about/legal/disclaimer.html (not restated here)"
    },
    {
      "name": "UCSC Genome Browser API, getData/sequence, genome hg19",
      "url_pattern": "https://api.genome.ucsc.edu/getData/sequence?genome=hg19;chrom=chr{chrom};start={pos-1};end={pos}",
      "license": "UCSC Genome Browser conditions of use: https://genome.ucsc.edu/conditions.html (not restated here)"
    },
    {
      "name": "tests/fixtures/panel_rsid_coordinates.json (committed Ensembl GRCh37 Variation REST snapshot, accessed 2026-07-16)",
      "role": "oracle allele_string"
    }
  ],
  "independence": "The two sequence sources are separate retrievals of the same GRC GRCh37/hg19 assembly. For the definitional question of which base the assembly carries, the assembly is the defining source, so they confirm one fact rather than providing two independent biological lines of evidence. The Variation snapshot is a third Ensembl product (variation, not sequence) and is not independent of the Ensembl sequence source.",
  "claim_mapping": {
    "tests/backend/test_regenerate_fixtures.py::_expected_grch37_reference_bases": "C1",
