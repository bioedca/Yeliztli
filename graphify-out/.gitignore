# Machine-local graphify state — regenerated per machine, NOT portable.
# Only the human-readable shared artifacts (GRAPH_REPORT.md and
# .graphify_labels.json) are committed. Everything below is local and must
# stay untracked:

# The graph itself. Previously committed so contributors/sessions could query
# without rebuilding, but it outgrew what GitHub can serve: at ~32 MB / ~940k
# lines the API refuses to generate a PR diff at all
#   422 "Sorry, this diff is taking too long to generate"
# which broke change detection outright (see .github/workflows/ci.yml), made
# the file unreviewable in the Files-changed UI, and defeated CodeRabbit's
# GitHub review. It only grows. Rebuild it locally instead — `graphify`'s
# AST cache (cache/, also untracked) makes that cheap, and the post-commit
# hook keeps it current:
#     /graphify            # first build in a fresh clone
#     /graphify --update   # incremental refresh
# GRAPH_REPORT.md stays committed as the reviewable, human-readable summary.
graph.json

# Interactive HTML viewer — generated by graphify (not hand-maintained
# source), regenerated with different content on every build, and used only
# by humans (sessions query graph.json / read GRAPH_REPORT.md). Kept out of
# git to avoid committing unmaintainable generated markup.
graph.html

# Absolute paths to this machine's repo root and python interpreter.
.graphify_root
.graphify_python

# Local token/cost accounting for graph builds.
cost.json

# Incremental-build state: keyed by absolute paths + local mtimes, so it is
# stale on any other checkout and would only cause churn/conflicts.
manifest.json

# Version-pinned AST build cache — regenerable, large, and churny.
cache/
